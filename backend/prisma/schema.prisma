datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Todo {
  id        String   @id @default(uuid())
  text      String
  category  String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Category {
  id   String @id @default(uuid())
  name String @unique
}
