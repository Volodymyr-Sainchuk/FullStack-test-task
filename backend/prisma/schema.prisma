datasource db {
  provider = "sqlite"
  url      = "file:/app/prisma/data/dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Todo {
  id        String   @id @default(uuid())
  text      String
  category  String
  completed Boolean  @default(false)
}

model Category {
  id   String @id @default(uuid())
  name String @unique
}